{
  "appId": "com.curfew.app",
  "productName": "Curfew",
  "npmRebuild": false,
  "directories": {
    "output": "dist"
  },
  "files": [
    "out/**/*",
    "resources/**/*",
    "node_modules/active-win/**/*"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": "resources",
      "filter": ["**/*"]
    }
  ],
  "asarUnpack": [
    "**/node_modules/active-win/**",
    "**/resources/**"
  ],
  "win": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Curfew"
  }
}
